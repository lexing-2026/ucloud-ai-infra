# ============================================================
#  答辩演示看板配置  Prometheus + Grafana + 对话演示
#  复制为 .env 后编辑:  cp .env.example .env
# ============================================================

# --- 4090 机器 SGLang 服务公网地址（届时填写） ---
# 例如公网 IP 为 1.2.3.4、SGLang 端口为 30000，则填:
#   SGLANG_HOST=1.2.3.4
#   SGLANG_PORT=30000
SGLANG_HOST=127.0.0.1
SGLANG_PORT=30000

# --- API 认证（SGLang 默认不校验，保持 EMPTY 即可） ---
API_KEY=EMPTY

# --- 模型 ID（与 SGLang --served-model-name 一致） ---
MODEL_NAME=qwen3.8-27b-fp8